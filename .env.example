# ─────────────────────────────────────────────────────────────
# CargoNotify — Variables d'environnement (VPS Production)
# Copiez ce fichier en .env et remplissez les valeurs réelles
# IMPORTANT : Ne jamais commiter le fichier .env sur Git !
# ─────────────────────────────────────────────────────────────

# Base de données PostgreSQL
DB_USER=postgres
DB_PASS=ChangeMe_Strong_Password_Here
DB_NAME=cargoNotify

# Authentification JWT
# Générer avec : openssl rand -hex 64
JWT_SECRET=ChangeMe_Min64Chars_RandomString_GeneratedWithOpenSSL
JWT_EXPIRES_IN=7d
